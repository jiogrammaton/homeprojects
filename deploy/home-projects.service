# systemd service: runs the app with gunicorn and restarts it if it crashes.
# This is a template with the defaults (/opt/homeprojects, user 'homeprojects', port 8000): install.sh writes
# /etc/systemd/system/home-projects.service from it with the folder, account and port you chose.
# Logs: sudo homeprojects logs   (plus logs/app.log and logs/security.log in the install folder)

[Unit]
Description=Home Projects (Django)
After=network.target

[Service]
User=homeprojects
Group=homeprojects
WorkingDirectory=/opt/homeprojects
ExecStart=/opt/homeprojects/venv/bin/gunicorn config.wsgi:application \
    --bind 0.0.0.0:8000 \
    --workers 2 \
    --access-logfile - \
    --forwarded-allow-ips 127.0.0.1
Restart=on-failure

# Hardening: the rest of the system is read-only to the app; it may only write inside its own folder
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/homeprojects

[Install]
WantedBy=multi-user.target
