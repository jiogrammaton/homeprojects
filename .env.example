# Copy to .env (same folder as manage.py) and fill in. Never share or commit .env.
# Values here are read at startup; real environment variables take priority.

# Hostnames / IP addresses other devices use to reach the app (comma-separated).
# localhost and 127.0.0.1 are always allowed.
DJANGO_ALLOWED_HOSTS=192.168.1.50,homeserver.local

# Leave empty to auto-generate one in .secret_key on first start (recommended).
DJANGO_SECRET_KEY=

# 1 only while developing on your own computer. Must be 0 on the server.
DJANGO_DEBUG=0

# Set to 1 only once the app sits behind an HTTPS reverse proxy (see deploy/Caddyfile).
DJANGO_HTTPS=0
# With HTTPS, list the full origin(s) here, e.g. https://homeserver.local
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 if a reverse proxy sets X-Forwarded-For (so logs and lockouts see the real client IP)
DJANGO_TRUST_X_FORWARDED_FOR=0

# Lock an IP out of the sign-in form after N failed attempts, for S seconds
DJANGO_LOGIN_MAX_ATTEMPTS=5
DJANGO_LOGIN_LOCKOUT_SECONDS=900

# Optional: keep the database and logs somewhere other than the app folder (e.g. a backed-up disk).
# The service may only write inside its install folder (/opt/homeprojects unless you chose another
# with install.sh --dir), so also add the new folder to ReadWritePaths= in /etc/systemd/system/home-projects.service.
# DJANGO_DB_PATH=/opt/homeprojects/db.sqlite3
# DJANGO_LOG_DIR=/opt/homeprojects/logs
